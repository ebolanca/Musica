  "Rihanna - Don't Stop The Music": {
    "title": "Don't Stop The Music",
    "artist": "Rihanna",
    "year": "2007",
    "album": "Good Girl Gone Bad",
    "synopsis": "Lanzado en mayo de 2007 como el cuarto sencillo de 'Good Girl Gone Bad', este tema consolidó la transición de Rihanna desde el reggae-pop caribeño hacia el electro-house y el dance-pop europeo. Producido por el dúo noruego StarGate, el corte destaca por su tempo riguroso a 122 BPM, su producción orientada al club nocturno y la recontextualización del célebre cántico de Manu Dibango y Michael Jackson.",
    "sections": [
      {
        "title": "Arquitectura Sónica y Producción Eurodance",
        "icon": "fa-sliders",
        "text": "StarGate abandonó las estructuras tradicionales del R&B contemporáneo para construir un engranaje de house sintético diseñado para sistemas de sonido de gran potencia. La pista utiliza un ritmo 'four-on-the-floor' grabado con muestreo de caja de ritmos estilo Roland TR-909, acoplado a una compresión en cadena lateral (sidechain) agresiva que produce el característico bombeo sónico en los sintetizadores bassline.",
        "points": [
          {
            "name": "Pulsación y Tonalidad",
            "desc": "Construida en la tonalidad de Fa sostenido menor (F#m) a 122 BPM, la canción sostiene una tensión armónica constante mediante una progresión F#m–A–C#m–Bm que evita resolver completamente a la tónica."
          },
          {
            "name": "Filtros y Ecualización Dinámica",
            "desc": "Durante los pre-coros, la mezcla aplica filtros pasa-altos (high-pass filtering) sobre la percusión para vaciar el espectro grave, creando un contraste dinámico masivo al liberar los bajos en el estribillo."
          }
        ]
      },
      {
        "title": "La Genealogía del Sample: Dibango, Jackson y StarGate",
        "icon": "fa-layer-group",
        "text": "El núcleo melódico del puente no es una invención original de 2007, sino un eslabón en una cadena de citas musicales que conecta el makossa camerunés con el pop global. La frase vocal 'Mama-say mama-sah ma-ma-coo-sah' funciona como un mantra rítmico que eleva la densidad de la pista hacia su clímax.",
        "points": [
          {
            "name": "Interpolación de 'Wanna Be Startin' Somethin'",
            "desc": "Michael Jackson aprobó personalmente el uso de la línea vocal grabada en 1982 para 'Thriller', la cual a su vez adaptaba la línea original de 'Soul Makossa' (1972) del saxofonista Manu Dibango."
          },
          {
            "name": "Tratamiento de las Voces Corales",
            "desc": "El cántico fue procesado con efectos de delay estéreo acoplados al tempo de 122 BPM y una reverberación de sala grande (hall reverb), superponiendo capas de la voz de Rihanna sobre el sample original."
          }
        ]
      },
      {
        "title": "Estructura Vocal y Ejecución en Estudio",
        "icon": "fa-microphone",
        "text": "Frente a una instrumental densa dominada por sintetizadores con modulación de onda de sierra (sawtooth synths), la interpretación vocal de Rihanna prescinde del melisma excesivo. Su entrega es rítmica, directa y metronómica, actuando casi como un instrumento de percusión adicional.",
        "points": [
          {
            "name": "Rango y Registro Vocal",
            "desc": "Rihanna mueve su voz en un rango contenido de F#3 a C#5, priorizando la colocación de pecho limpia en las estrofas y una proyección resonante en el registro medio durante el coro."
          },
          {
            "name": "Capas Vocales (Vocal Stacking)",
            "desc": "Los arreglos vocales de Tawanna Dabney incorporan doblajes precisos en los finales de frase y armonías en terceras durante el estribillo para cortar a través de las frecuencias medias de los sintetizadores."
          }
        ]
      }
    ]
  },
